---
import Header from "../components/header.astro";
import CommandPalette from "../components/command-palette.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";

const {
  title = "Tyler Dalton",
  socialTitle = title,
  description = "Cybersecurity and Systems Administration student at the University of Cincinnati focused on secure infrastructure and automation.",
  image = "/og-img.png",
  imageAlt = "Tyler Dalton portfolio",
  showChrome = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Document Metadata -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Default matches the dark --page-background. The bootstrap below replaces it before paint. -->
    <meta name="theme-color" content="#2c3e50" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical states -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- FOR THE CRAWLERS!!! -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tyler Dalton" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt}/>

    <!-- Social Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <script is:inline>
      (function () {
        // Match --page-background in dark.css, light.css, and matrix.css.
        var themeColors = { dark: "#2c3e50", light: "#ecf0f1", matrix: "#050e06" };
        var theme = "dark";
        try {
          if (sessionStorage.getItem("matrix-session") === "1") theme = "matrix";
          else if (localStorage.getItem("theme") === "light") theme = "light";
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", themeColors[theme]);
      })();
    </script>
  </head>

  <body class="bg-[var(--page-background)] text-[var(--page-foreground)]">
    <!-- Inert until Matrix mode starts. Keeping one mount point avoids duplicate canvases. -->
    <canvas
      id="matrix-canvas"
      class="matrix-canvas"
      aria-hidden="true"
      role="presentation"
    ></canvas>

    <div
      id="matrix-live"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      class="sr-only"
    ></div>

    <aside
      id="matrix-rabbit-hint"
      class="matrix-rabbit-hint"
      aria-label="Site easter egg hint"
      hidden
    >
      <p><span>Got some time?</span> Follow the white rabbit.</p>
      <button id="matrix-rabbit-hint-dismiss" type="button" aria-label="Dismiss hint">×</button>
    </aside>

    <div
      id="matrix-access-notice"
      class="matrix-access-notice"
      aria-hidden="true"
      hidden
    >
      <p id="matrix-access-title" class="matrix-access-notice__title">ACCESS GRANTED</p>
      <p id="matrix-access-detail" class="matrix-access-notice__detail">SYSTEM OVERRIDE // UNRESTRICTED ACCESS</p>
    </div>

    {showChrome && <Header />}
    <CommandPalette />

    <main>
      <slot />
    </main>

    {showChrome && <Footer />}

    <!-- Matrix controls (hidden until activated) -->
    <div
      id="matrix-controls"
      aria-hidden="true"
      hidden
    >
      <button
        id="matrix-pause-btn"
        type="button"
        class="matrix-ctrl-btn"
        aria-label="Pause matrix rain animation"
      >Pause rain</button>
      <button
        id="matrix-exit-btn"
        type="button"
        class="matrix-ctrl-btn"
        aria-label="Exit Matrix mode and return to normal theme"
      >Exit Matrix</button>
    </div>

    <!-- Astro bundles this; Vite resolves the relative .ts import -->
    <script>
      import { initMatrix } from "../scripts/matrix-mode";
      import { watchThemeColor } from "../scripts/theme-color";
      watchThemeColor();
      initMatrix().catch((error) => {
        console.error("[matrix] initialization failed", error);
      });
    </script>
  </body>
</html>
