---
import { countLabel, formatFull } from "../lib/github-analytics";

interface Props {
  total: number;
  from: string;
  to: string;
}

const { total, from, to } = Astro.props;
const label = `${countLabel(total, "contribution")} from ${formatFull(from)} to ${formatFull(to)}`;
---

<div data-contribution-root>
  <div class="overflow-x-auto">
    <div
      data-contribution-graph
      class="block min-w-[735px] [&_svg]:block [&_svg]:h-auto [&_svg]:w-full"
      aria-label={label}
    >
      <img
        src="/github/contributions.svg"
        alt={label}
        class="block h-auto w-full"
        loading="lazy"
      />
    </div>
  </div>
  <div
    data-contribution-tooltip
    class="pointer-events-none fixed z-50 hidden rounded-md border border-[var(--page-border)] bg-[var(--terminal-chrome)] px-2.5 py-1.5 text-xs text-[var(--terminal-foreground)] shadow-lg"
    role="tooltip"
  >
  </div>
</div>

<script>
  const LEVELS: Record<string, string> = {
    "#405467": "0",
    "#1a4a6b": "1",
    "#1d6fa4": "2",
    "#2196c9": "3",
    "#3dc8f5": "4",
  };

  document.querySelectorAll<HTMLElement>("[data-contribution-root]").forEach((root) => {
    const graph = root.querySelector<HTMLElement>("[data-contribution-graph]");
    const tooltip = root.querySelector<HTMLElement>("[data-contribution-tooltip]");
    if (!graph || !tooltip || graph.dataset.enhanced === "true") return;
    graph.dataset.enhanced = "true";

    const formatDate = (date: string) =>
      new Intl.DateTimeFormat("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
      }).format(new Date(`${date}T00:00:00Z`));

    const tooltipText = (square: SVGRectElement) => {
      const date = square.dataset.date;
      const count = Number(square.dataset.count ?? 0);
      const contributionWord = count === 1 ? "contribution" : "contributions";
      return `${count} ${contributionWord} on ${formatDate(date!)}`;
    };

    const positionTooltip = (x: number, y: number) => {
      const offset = 12;
      const padding = 8;
      const rect = tooltip.getBoundingClientRect();
      let left = x + offset;
      let top = y - rect.height - offset;

      if (left + rect.width > window.innerWidth - padding) left = x - rect.width - offset;
      if (top < padding) top = y + offset;

      tooltip.style.left = `${Math.max(padding, left)}px`;
      tooltip.style.top = `${Math.max(padding, top)}px`;
    };

    const showTooltip = (square: SVGRectElement, x: number, y: number) => {
      tooltip.textContent = tooltipText(square);
      tooltip.classList.remove("hidden");
      positionTooltip(x, y);
    };

    const hideTooltip = () => {
      tooltip.classList.add("hidden");
    };

    fetch("/github/contributions.svg")
      .then((response) => {
        if (!response.ok) throw new Error("Could not load contribution graph");
        return response.text();
      })
      .then((svgText) => {
        const parsed = new DOMParser().parseFromString(svgText, "image/svg+xml");
        const svg = parsed.documentElement;
        if (svg.nodeName.toLowerCase() !== "svg") return;

        svg.removeAttribute("role");
        svg.removeAttribute("aria-label");
        svg.setAttribute("aria-hidden", "true");

        svg.querySelectorAll("rect").forEach((square) => {
          const level = LEVELS[(square.getAttribute("fill") || "").toLowerCase()];
          if (level) square.setAttribute("data-level", level);

          const title = square.querySelector("title");
          if ((!square.getAttribute("data-date") || square.getAttribute("data-count") === null) && title?.textContent) {
            const match = title.textContent.match(/^(\d{4}-\d{2}-\d{2}): (\d+) contributions?$/);
            if (match) {
              square.setAttribute("data-date", match[1]);
              square.setAttribute("data-count", match[2]);
            }
          }

          title?.remove();
          square.removeAttribute("tabindex");
          square.removeAttribute("role");
          square.removeAttribute("aria-label");
          square.setAttribute("aria-hidden", "true");
        });

        graph.replaceChildren(document.importNode(svg, true));

        graph.querySelectorAll("rect").forEach((square) => {
          if (!square.dataset.date || square.dataset.count === undefined) return;
          square.addEventListener("pointerenter", (event) => {
            showTooltip(square, event.clientX, event.clientY);
          });
          square.addEventListener("pointermove", (event) => {
            positionTooltip(event.clientX, event.clientY);
          });
          square.addEventListener("pointerleave", hideTooltip);
        });
      })
      .catch(() => {});
  });
</script>
