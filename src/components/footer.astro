---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--page-border)] bg-[var(--page-background)] text-[var(--page-foreground)]">
  <div
    class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-4 text-center md:flex-row md:items-center md:justify-between"
  >
    <div class="md:text-left">
      <p class="font-bold">Email:</p>
      <a
        href="mailto:tldalton54@gmail.com"
        class="text-[var(--page-foreground)] underline-offset-4 hover:underline"
      >
        tldalton54@gmail.com
      </a>
    </div>

    <div class="md:text-center">
      <p class="font-bold">GitHub:</p>
      <a
        href="https://github.com/tyler-dalton"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[var(--page-foreground)] underline-offset-4 hover:underline"
      >
        github.com/tyler-dalton
      </a>
    </div>

    <div class="md:text-right">
      <div class="flex items-center justify-center gap-2 md:justify-end">
        <p>&copy; {year} · v3.2.0</p>
        <button
          id="white-rabbit-btn"
          type="button"
          class="white-rabbit-btn"
          aria-label="Follow the white rabbit"
        >
          <svg
            class="white-rabbit-svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M8.5 11.5 7 4.3c-.2-1 .7-1.8 1.6-1.3l3.1 6.1" />
            <path d="M15.5 11.5 17 4.3c.2-1-.7-1.8-1.6-1.3l-3.1 6.1" />
            <path d="M5.5 14.5c0-3.4 2.9-6.1 6.5-6.1s6.5 2.7 6.5 6.1c0 3.5-2.9 6.3-6.5 6.3s-6.5-2.8-6.5-6.3Z" />
            <path d="M9.3 14.7h.1m5.2 0h.1M10 18c1.2.7 2.8.7 4 0" />
          </svg>
          <span class="white-rabbit-label">follow the white rabbit</span>
        </button>
      </div>
    </div>
  </div>
</footer>
