---
import Layout from "../layouts/layout.astro";
import AboutTerminal from "../components/terminal.astro";
import SelectedWork from "../components/project-card.astro";
---

<Layout title="Tyler Dalton | Home">
  <!-- HERO -->
	<section class="px-4 py-16">
    <div class="mx-auto flex max-w-[1100px] flex-col items-center gap-12 md:flex-row">
      <!-- Headshot -->
      <div>
        <img
          src="/media/headshot.jpg"
          alt="Professional headshot of Tyler Dalton"
          class="h-[260px] w-[260px] rounded-full border-3 border-white/15 object-cover shadow-[0_18px_40px_rgba(0,0,0,0.18)] md:h-[340px] md:w-[340px]"
        />
      </div>
      <!-- Introduction -->
      <div class="max-w-xl">
        <h1 class="mb-3 text-5xl font-bold tracking-tight md:text-6xl">
          Hi, I'm Tyler Dalton.
        </h1>
        <p class="max-w-xl text-xl leading-relaxed text-[#ecf0f1]/90 md:text-2xl">
          Cybersecurity + Systems Administration student at the University of Cincinnati focused on secure infrastructure and automation.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/projects"
            class="inline-block rounded-full bg-[#ecf0f1] px-[1.6em] py-[0.65em] font-semibold tracking-[0.2em] text-[#2c3e50] no-underline transition-all duration-200 hover:-translate-y-0.5"
          >
            View My Work
          </a>
          <a
            href="/contact"
            class="inline-block rounded-full border border-[#ecf0f1]/60 px-[1.6em] py-[0.65em] font-semibold tracking-[0.2em] text-[#ecf0f1] no-underline transition-all duration-200 hover:-translate-y-0.5 hover:bg-white/10"
          >
            Contact Me
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- Imorting About Terminal from Componets -->
  <AboutTerminal />
  <!-- Selected Projects import from components -->
  <SelectedWork />
</Layout>