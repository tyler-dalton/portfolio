---
import { projectViews, projectsForView, type ProjectView } from "../data/projects";
interface Props { view?: ProjectView }
const { view = "featured" } = Astro.props;
const visibleProjects = projectsForView(view);
const viewLabel = projectViews.find((item) => item.id === view)?.label ?? "Featured";
---
<section class="px-4 py-16 md:py-24">
  <div class="mx-auto max-w-[1100px]">
    <div class="flex flex-col justify-between gap-6 border-b border-[var(--page-border)] pb-8 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight md:text-6xl">
          Projects
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--page-secondary)]">
          A working archive of infrastructure, automation, and software built to be useful in the real world.
        </p>
      </div>
      <p class="font-mono text-sm text-[var(--page-muted)]">View: {viewLabel}</p>
    </div>
    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Project views">{projectViews.map((item) =>
      <a href={item.href}
        aria-current={item.id === view ? "page" : undefined}
        class:list={["rounded-full border px-4 py-2 font-mono text-xs uppercase tracking-[0.12em] no-underline transition-colors", item.id === view ? "border-[var(--page-foreground)] bg-[var(--page-foreground)] text-[var(--page-background)]" : "border-[var(--page-border)] text-[var(--page-secondary)] hover:border-[var(--page-foreground)] hover:text-[var(--page-foreground)]"]}>
        {item.label}
      </a>)}
    </nav>
    <div class="mt-10">{visibleProjects.map((project) =>
      <article class="grid gap-6 border-b border-[var(--page-border)] py-10 md:grid-cols-[180px_1fr]">
        <div class="font-mono text-sm text-[var(--page-muted)]">
          <p>{project.number}</p>
          <p class="mt-1">{project.period}</p>
        </div>
        <div>
          <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
            <h2 class="text-3xl font-bold">
              {project.title}
            </h2>
            <p class="font-mono text-sm text-[var(--page-muted)]">
              {project.organization}
            </p>
          </div>
          <p class="mt-2 text-lg text-[var(--page-secondary)]">
            {project.subtitle}
          </p>{project.description.map((paragraph, index) =>
          <p class:list={["max-w-3xl text-lg leading-relaxed text-[var(--page-secondary)]", index === 0 ? "mt-5" : "mt-4"]}>
            {paragraph}
          </p>)}
          <div class="mt-6 font-mono text-sm text-[var(--page-muted)]">
            {project.technologies.join(" / ")}
          </div>
        </div>
      </article>)}
    </div>
  </div>
</section>
