---
import Layout from "../../layouts/layout.astro";
import Gantt from "../../components/activity/gantt.astro";
import { timeline } from "../../data/activity";
import "../../styles/activity.css";
---

<Layout
  title="Tyler Dalton | Timeline"
  socialTitle="Timeline - Tyler Dalton"
  description="Published milestones for Tyler Dalton: the Panoptes case study and the personal infrastructure lab."
>
  <section class="px-4 py-16 md:py-24">
    <div class="mx-auto max-w-[1100px]">
      <header class="activity-intro">
        <p class="activity-kicker">Activity</p>
        <h1>Timeline</h1>
        <p class="activity-lede">
          Milestones that already have a public page or repository. Each bar runs from its start date to its end date, earliest start first.
          Resume lines whose titles or dates still disagree stay on the resume and are not repeated here.
        </p>
      </header>
      <Gantt entries={timeline} />
    </div>
  </section>
</Layout>
