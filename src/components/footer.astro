  <div
    class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-4 text-center md:flex-row md:items-center md:justify-between"
  >
    <div class="md:text-left">
      <p class="font-bold">Email:</p>
      <a
        href="mailto:tldalton54@gmail.com"
        class="--text-color underline-offset-4 hover:underline"
      >
        tldalton54@gmail.com
      </a>
    </div>

    <div class="md:text-center">
      <p class="font-bold">GitHub:</p>
      <a
        href="https://github.com/tyler-dalton"
        target="_blank"
        rel="noopener noreferrer"
        class="--text-color underline-offset-4 hover:underline"
      >
        github.com/tyler-dalton
