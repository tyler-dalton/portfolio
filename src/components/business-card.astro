---
const cardURL = new URL("/card", Astro.site ?? Astro.url).href;
---

<section class="business-card-page">
  <article class="business-card" aria-labelledby="card-name">
    <img class="card-headshot" src="/media/headshot.jpg" alt="Tyler Dalton" width="160" height="160" />
    <h1 id="card-name">Tyler Dalton</h1>
    <p class="card-role">Cybersecurity + Systems Administration</p>
    <p class="card-school">University of Cincinnati</p>
    <div class="contact-actions">
      <a class="card-button" href="/media/tyler-dalton.vcf" download="Tyler-Dalton.vcf">Save Contact</a>
      <a class="card-button card-button--secondary" href="mailto:tldalton54@gmail.com">Send Email</a>
    </div>
    <nav class="contact-grid" aria-label="Connect with Tyler">
      <a class="contact-card linkedin" href="https://linkedin.com/in/daltontyler/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="36" height="36">
<path d="M6.5 8C7.32843 8 8 7.32843 8 6.5C8 5.67157 7.32843 5 6.5 5C5.67157 5 5 5.67157 5 6.5C5 7.32843 5.67157 8 6.5 8Z" fill="currentColor"/>
<path d="M5 10C5 9.44772 5.44772 9 6 9H7C7.55228 9 8 9.44771 8 10V18C8 18.5523 7.55228 19 7 19H6C5.44772 19 5 18.5523 5 18V10Z" fill="currentColor"/>
<path d="M11 19H12C12.5523 19 13 18.5523 13 18V13.5C13 12 16 11 16 13V18.0004C16 18.5527 16.4477 19 17 19H18C18.5523 19 19 18.5523 19 18V12C19 10 17.5 9 15.5 9C13.5 9 13 10.5 13 10.5V10C13 9.44771 12.5523 9 12 9H11C10.4477 9 10 9.44772 10 10V18C10 18.5523 10.4477 19 11 19Z" fill="currentColor"/>
<path fill-rule="evenodd" clip-rule="evenodd" d="M20 1C21.6569 1 23 2.34315 23 4V20C23 21.6569 21.6569 23 20 23H4C2.34315 23 1 21.6569 1 20V4C1 2.34315 2.34315 1 4 1H20ZM20 3C20.5523 3 21 3.44772 21 4V20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V4C3 3.44772 3.44772 3 4 3H20Z" fill="currentColor"/>
        </svg>
        <h2>LinkedIn</h2>
      </a>
      <a class="contact-card github" href="https://github.com/tyler-dalton" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="36" height="36">
<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        <h2>GitHub</h2>
      </a>
    </nav>
    <a class="portfolio-link" href="/">View My Portfolio <span aria-hidden="true">&rarr;</span></a>
    <div class="share-actions">
      <button id="share-card" type="button" hidden>Share Card</button>
      <p id="share-status" role="status" aria-atomic="true"></p>
      <div id="share-fallback" hidden>
        <label for="card-url">Copy this link to share</label>
        <input id="card-url" type="url" value={cardURL} readonly />
      </div>
      <noscript><p>Share this card: <a href={cardURL}>{cardURL}</a></p></noscript>
    </div>
  </article>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>("#share-card");
  const status = document.querySelector<HTMLElement>("#share-status");
  const fallback = document.querySelector<HTMLElement>("#share-fallback");
  const urlInput = document.querySelector<HTMLInputElement>("#card-url");

  if (button && status && fallback && urlInput) {
    // Share the current origin so local and preview builds do not point to production.
    const url = new URL("/card", window.location.origin).href;
    urlInput.value = url;
    button.hidden = false;

    button.addEventListener("click", async () => {
      status.textContent = "";
      fallback.hidden = true;
      button.disabled = true;
      try {
        if (navigator.share) {
          try {
            await navigator.share({ title: "Tyler Dalton | Digital Business Card", url });
            status.textContent = "Card shared.";
            return;
          } catch (error) {
            if (error instanceof Error && error.name === "AbortError") return;
          }
        }
        await navigator.clipboard.writeText(url);
        status.textContent = "Card link copied. Ready to share.";
      } catch {
        fallback.hidden = false;
        urlInput.focus();
        urlInput.select();
        status.textContent = "Select and copy the link below.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .business-card-page {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: max(2.5rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) max(2.5rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
  }
  .business-card { width: 100%; max-width: 480px; text-align: center; }
  .card-headshot {
    display: block;
    width: 160px;
    height: 160px;
    margin: 0 auto;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--page-border);
    box-shadow: 0 18px 40px rgb(0 0 0 / 18%);
  }
  h1 { font-size: clamp(2.4rem, 8vw, 3.2rem); font-weight: 700; letter-spacing: -0.03em; margin: 0.5em 0 0.2em; }
  .card-role { font-size: 1.15rem; line-height: 1.6; }
  .card-school { margin-top: 0.4em; line-height: 1.6; color: var(--page-secondary); }
  .contact-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1.75rem; }
  .card-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.6em 1.1em;
    border: 1px solid var(--page-foreground);
    border-radius: 999px;
    background: var(--page-foreground);
    color: var(--page-background);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: transform 160ms ease, background-color 160ms ease;
  }
  .card-button--secondary { background: transparent; color: var(--page-foreground); border-color: var(--page-border); }
  .card-button:hover { transform: translateY(-2px); }
  .card-button--secondary:hover { background: color-mix(in srgb, var(--page-foreground) 8%, transparent); }
  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 1.75rem 0; }
  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.4rem 0.75rem;
    border: 1px solid var(--page-border);
    border-radius: 18px;
    background: color-mix(in srgb, var(--page-foreground) 5%, transparent);
    color: var(--page-foreground);
    text-decoration: none;
    transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }
  .contact-card:hover { transform: translateY(-4px); background: color-mix(in srgb, var(--page-foreground) 8%, transparent); }
  .linkedin:hover { border-color: #0a66c2; }
  .github:hover { border-color: var(--page-foreground); }
  .contact-card h2 { font-size: 1.1rem; font-weight: 600; margin-top: 0.3em; }
  .portfolio-link { display: inline-block; padding: 0.75rem; color: var(--page-foreground); text-decoration: underline; text-underline-offset: 0.3em; }
  .portfolio-link:hover { color: var(--page-accent); }
  .share-actions { margin-top: 1rem; }
  #share-card {
    min-height: 44px;
    padding: 0.5em 1.25em;
    border: 1px solid var(--page-border);
    border-radius: 999px;
    background: transparent;
    color: var(--page-foreground);
    font: inherit;
    cursor: pointer;
  }
  #share-card:hover { background: color-mix(in srgb, var(--page-foreground) 5%, transparent); }
  #share-card:disabled { opacity: 0.6; cursor: wait; }
  #share-status { font-size: 0.9rem; line-height: 1.5; }
  #share-status:not(:empty), #share-fallback { margin-top: 1rem; }
  #card-url { width: 100%; margin-top: 0.5rem; padding: 0.75rem; border: 1px solid var(--page-border); border-radius: 8px; background: var(--page-background); color: var(--page-foreground); font: inherit; }
  .business-card :focus-visible { outline: 3px solid var(--page-accent); outline-offset: 4px; }
  [hidden] { display: none !important; }
  @media (prefers-reduced-motion: reduce) {
    .business-card a { transition: none; }
    .business-card a:hover { transform: none; }
  }
</style>
