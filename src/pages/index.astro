---
import Layout from "../layouts/layout.astro";
import AboutTerminal from "../components/terminal.astro";
import SelectedWork from "../components/projects/selected-work.astro";
import ContributionGraph from "../components/contribution-graph.astro";
import { analytics } from "../lib/analytics-view";
---

<Layout title="Tyler Dalton | Home"
        socialTitle="Tyler Dalton"
        description="Cybersecurity and Systems Administration student at the University of Cincinnati focused on secure infrastructure and automation."
>
  <!-- HERO -->
	<section class="px-4 py-16">
    <div class="mx-auto flex max-w-[1100px] flex-col items-center gap-12 md:flex-row">
      <!-- Headshot -->
      <div>
        <img
          src="/media/headshot.jpg"
          alt="Professional headshot of Tyler Dalton"
          class="h-[260px] w-[260px] rounded-full border-3 border-[var(--page-border)] object-cover shadow-[0_18px_40px_rgba(0,0,0,0.18)] md:h-[340px] md:w-[340px]"
        />
      </div>
      <!-- Introduction -->
      <div class="max-w-xl">
        <h1 class="mb-3 text-5xl font-bold tracking-tight md:text-6xl">
          Hi, I'm Tyler Dalton.
        </h1>
        <p class="max-w-xl text-xl leading-relaxed text-[var(--page-secondary)] md:text-2xl">
          Cybersecurity + Systems Administration student at the University of Cincinnati focused on secure infrastructure and automation.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/work/projects"
            class="inline-block rounded-full bg-[var(--page-foreground)] px-[1.6em] py-[0.65em] font-semibold tracking-[0.2em] text-[var(--page-background)] no-underline transition-all duration-200 hover:-translate-y-0.5"
          >
            View My Work
          </a>
          <a
            href="/contact"
            class="inline-block rounded-full border border-[var(--page-border)] px-[1.6em] py-[0.65em] font-semibold tracking-[0.2em] text-[var(--page-foreground)] no-underline transition-all duration-200 hover:-translate-y-0.5 hover:bg-[color-mix(in_srgb,var(--page-foreground)_10%,transparent)] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
          >
            Contact me
          </a>
        </div>
      </div>
    </div>
    <div class="mt-14 text-center md:mt-16">
      <button
        id="command-palette-trigger"
        type="button"
        class="command-hint"
        aria-label="Open command palette"
      >
        Check out my command palette (<kbd>⌘ K / Ctrl + K</kbd>)
      </button>
    </div>
  </section>
  <!-- Importing About Terminal from Components -->
  <AboutTerminal />
  <!-- Selected Projects import from components -->
  <SelectedWork />

  <!-- GitHub Contribution Activity -->
  <section class="px-4 py-6">
      <div class="mx-auto max-w-[1100px] pt-10">
        <div class="mb-5 flex flex-col items-start gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <h2 class="text-3xl font-semibold tracking-tight">GitHub Contributions</h2>
          <a
            href="https://github.com/tyler-dalton"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap text-sm text-[var(--page-muted)] transition-colors hover:text-[var(--page-foreground)]"
          >
            @tyler-dalton
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <ContributionGraph
          total={analytics.contributionTotal}
          from={analytics.contributionFrom}
          to={analytics.contributionTo}
        />
      </div>
    </section>
</Layout>
