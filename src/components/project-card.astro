---
import { projectsForView } from "../data/projects";
const projects = projectsForView("featured");
---
<section class="px-4 py-20">
  <div class="mx-auto max-w-[1100px]">
    <div class="flex items-end justify-between border-b border-[var(--page-border)] pb-4">
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl">
        Selected Work
      </h2>
      <a href="/work/projects"
        class="hidden text-sm text-[var(--page-muted)] transition-colors hover:text-[var(--page-foreground)] md:block">
          View all projects →
      </a>
    </div>
    {projects.map((project) =>
    <article class="grid gap-6 border-b border-[var(--page-border)] py-10 md:grid-cols-[180px_1fr]">
      <div class="font-mono text-sm text-[var(--page-muted)]">
        <p>{project.number}</p>
        <p class="mt-1">{project.period}</p>
      </div>
      <div>
        <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
          <h3 class="text-3xl font-bold">{project.title}</h3>
          {project.organization && <p class="font-mono text-sm text-[var(--page-muted)]">{project.organization}</p>}
        </div>
        <p class="mt-2 text-lg text-[var(--page-secondary)]">{project.subtitle}</p>
        {project.description.map((paragraph, index) =>
        <p class:list={["max-w-3xl text-lg leading-relaxed text-[var(--page-secondary)]", index === 0 ? "mt-5" : "mt-4"]}>
          {paragraph}</p>)}
          <div class="mt-6 font-mono text-sm text-[var(--page-muted)]">
            {project.technologies.join(" / ")}
          </div>
          <a href="/work/projects/featured"
            class="mt-6 inline-block font-medium text-[var(--page-foreground)] underline decoration-[var(--page-border)] underline-offset-4 transition-colors hover:text-[var(--page-accent)]">
          View project →
          </a>
      </div>
    </article>)}
  </div>
</section>
