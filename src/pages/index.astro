---
import Layout from "../layouts/layout.astro";
---

<Layout title="Tyler Dalton | Home">
  <!-- HERO -->
	<section class="px-4 py-16">
    <div class="mx-auto flex max-w-[1100px] items-center gap-12">
      <!-- Headshot -->
      <div>
        <img
          src="/media/headshot.jpg"
          alt="Professional headshot of Tyler Dalton"
          class="h-[340px] w-[340px] rounded-full object-cover"
        />
      </div>

      <!-- Introduction -->
      <div>
        <h1 class="mb-3 text-5xl font-bold tracking-tight med:text-6xl">
          Hi, I'm Tyler Dalton.
        </h1>
        <p class="max-w-xl text-xl leading-relaxed text-[#ecf0f1]/90 md:text-2xl">
          Cybersecurity + Systems Administration student at the University of Cincinnati focused on secure infrastructure and automation.
        </p>
        <a
          href="/projects"
          class="mt-6 inline-block rounded-full bg-[#ecf0f1] px-[1.6em] py-[0.65em] font-semibold tracking-[0.2em] text-[#2c3e50] no-underline transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#1f2f3f] hover:text-[#ecf0f1] hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3498db]"
        >
          View My Work
        </a>
      </div>
    </div>
  </section>
</Layout>