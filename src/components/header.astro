---
const currentPath = Astro.url.pathname;

const navItems = [
    {label: "Home", href: "/" },
    {label: "Projects", href: "/projects"},
    {label: "Resume", href: "/resume"},
    {label: "Personal", href: "/personal"},
    {label: "Contact", href: "/contact"}
];
---

<header class="bg-[#2c3e50] text-[#ecf0f1]">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between px-4 py-1">
        <h1 class="m-0">
            <a 
                href="/"
                class="text-3xl font-bold tracking-tight text-[#ecf0f1] no-underline transition-colors duration-150 hover:text-[#3498db] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3498db]">
                Tyler Dalton
            </a>
        </h1>
        <button 
            id="nav-toggle"
            type="button" 
            class="flex min-h-11 min-w-11 flex-col items-center justify-center gap-1.5 rounded-lg transition-colors hover:bg-white/10 md:hidden"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-nav">
            <span 
              id="nav-bar-1"
              class="h-0.5 w-7 bg-[#ecf0f1] transition-transform duration-300"
            ></span>
            <span 
              id="nav-bar-2" 
              class="h-0.5 w-7 bg-[#ecf0f1] transition-opacity duration-300"
            ></span>
            <span 
              id="nav-bar-3" 
              class="h-0.5 w-7 bg-[#ecf0f1] transition-transform duration-300"
            ></span>
        </button>
        <div class="flex items-center gap-3">
        <nav class="hidden md:block">
            <ul class="flex list-none items-center gap-6 p-3">
            {
                navItems.map((item) => {
                    const isActive =
                    item.href === "/"
                    ? currentPath === "/"
                    : currentPath.startsWith(item.href);
                    
                    return (
                        <li class="relative pl-6 first:pl-0 before:absolute before:left-0 before:text-[#ecf0f1]/50 before:content-['|'] first:before:hidden">
                            <a href={item.href}
                            aria-current={isActive ? "page" : undefined}
                            class:list={[
                            "text-xl text-[#ecf0f1] no-underline transition-colors duration-150 hover:text-[#3498db] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3498db]",
                            { "font-bold !text-[#3498db]": isActive }
                        ]}
                            >
                            {item.label}
                            </a>
                        </li>
                    )
                })
            }
            </ul>
        </nav>
        <button id="command-palette-trigger" class="command-trigger hidden md:block" type="button" aria-haspopup="dialog" aria-controls="command-palette">
          Commands <kbd>⌘K</kbd>
        </button>
        </div>
        <nav
          id="mobile-nav"
          class="hidden w-full border-t border-white/20 md:hidden"
          aria-label="Mobile"
        >
            <ul class="flex list-none flex-col gap-0 p-3">
                {
                    navItems.map((item) => {
                        const isActive =
                        item.href === "/"
                        ? currentPath === "/"
                        : currentPath.startsWith(item.href);

                        return (
                            <li>
                                <a href={item.href}
                                    aria-current={isActive ? "page" : undefined}
                                    class:list={[
                                        "block py-3 text-lg text-[#ecf0f1] no-underline transition-colors duration-150 hover:text-[#3498db] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#3498db]",
                                        { "font-bold !text-[#3498db]": isActive }
                                    ]}
                                >
                                    {item.label}
                                </a>
                            </li>
                        )
                    })
                }
            </ul>
        </nav>
    </div>
    <dialog id="command-palette" class="command-palette" aria-labelledby="command-palette-title">
      <div class="command-palette__header" id="command-palette-title">Command palette</div>
      <button id="theme-command" class="command-palette__action" type="button">
        <span id="theme-command-label">Switch to dark theme</span>
        <span class="command-palette__shortcut">Enter</span>
      </button>
    </dialog>
    <script>
    const toggle = document.getElementById("nav-toggle");
    const mobileNav = document.getElementById("mobile-nav");
    const bar1 = document.getElementById("nav-bar-1");
    const bar2 = document.getElementById("nav-bar-2");
    const bar3 = document.getElementById("nav-bar-3");
    const commandPalette = document.getElementById("command-palette") as HTMLDialogElement | null;
    const commandTrigger = document.getElementById("command-palette-trigger");
    const themeCommand = document.getElementById("theme-command");
    const themeCommandLabel = document.getElementById("theme-command-label");

    const setTheme = (theme: "light" | "dark") => {
      document.documentElement.dataset.theme = theme;
      localStorage.setItem("theme", theme);
      if (themeCommandLabel) themeCommandLabel.textContent = `Switch to ${theme === "light" ? "dark" : "light"} theme`;
    };

    const openCommandPalette = () => {
      if (!commandPalette?.open) {
        const theme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        setTheme(theme);
        commandPalette?.showModal();
        themeCommand?.focus();
      }
    };

    commandTrigger?.addEventListener("click", openCommandPalette);
    themeCommand?.addEventListener("click", () => {
      setTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark");
      commandPalette?.close();
    });

    window.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        openCommandPalette();
      }
    });

    if (toggle && mobileNav) {
      const closeMenu = () => {
        mobileNav.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Open menu");

        bar1?.classList.remove("translate-y-2", "rotate-45");
        bar2?.classList.remove("opacity-0");
        bar3?.classList.remove("-translate-y-2", "-rotate-45");
      };

      const openMenu = () => {
        mobileNav.classList.remove("hidden");
        toggle.setAttribute("aria-expanded", "true");
        toggle.setAttribute("aria-label", "Close menu");

        bar1?.classList.add("translate-y-2", "rotate-45");
        bar2?.classList.add("opacity-0");
        bar3?.classList.add("-translate-y-2", "-rotate-45");
      };

      toggle.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        isOpen ? closeMenu() : openMenu();
      });

      mobileNav.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          closeMenu();
        }
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
        }
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) {
          closeMenu();
        }
      });
    }
  </script>
</header>
