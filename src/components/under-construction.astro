---
interface Props {
  title: string;
  path: string;
  message?: string;
}

const {
  title,
  path,
  message = "This page is currently being refactored from a promising idea into a reasonably organized reality.",
} = Astro.props;
---

<section class="px-4 py-20 md:py-28">
  <div class="mx-auto max-w-[850px]">
    <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#0f1720] shadow-2xl">
      <div class="flex items-center justify-between border-b border-white/10 bg-[#17212b] px-4 py-3">
        <div class="flex items-center gap-2" aria-hidden="true">
          <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
          <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
          <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
        </div>
        <p class="font-mono text-sm text-white/60">tyler@portfolio: ~{path}</p>
        <span class="font-mono text-xs text-white/40">bash</span>
      </div>

      <div class="space-y-6 p-6 font-mono text-sm leading-relaxed text-[#d6e2ea] md:p-8 md:text-base">
        <div>
          <p><span class="text-[#3498db]">tyler@portfolio</span>:<span class="text-[#8fb3c9]">~</span>$ open {path}</p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight text-white md:text-4xl">{title}</h1>
        </div>

        <div>
          <p><span class="text-[#3498db]">tyler@portfolio</span>:<span class="text-[#8fb3c9]">~</span>$ git status</p>
          <p class="mt-2 text-[#febc2e]">On branch: currently-refactoring</p>
          <p class="text-white/80">Changes not staged for publication.</p>
        </div>

        <div>
          <p><span class="text-[#3498db]">tyler@portfolio</span>:<span class="text-[#8fb3c9]">~</span>$ cat progress.log</p>
          <p class="mt-2 max-w-2xl text-white/80">{message}</p>
        </div>

        <div class="border-t border-white/10 pt-6">
          <p><span class="text-[#3498db]">tyler@portfolio</span>:<span class="text-[#8fb3c9]">~</span>$ _<span class="animate-pulse text-white">█</span></p>
        </div>
      </div>
    </div>

    <a
      href="/"
      class="mt-8 inline-block font-medium text-[#ecf0f1] underline decoration-white/30 underline-offset-4 transition-colors hover:text-white"
    >
      Return home →
    </a>
  </div>
</section>
