<section class="px-4 py-20">
  <div class="mx-auto max-w-[1100px]">
    <div class="overflow-hidden rounded-2xl border border-[var(--page-border)] bg-[var(--terminal-background)] shadow-2xl">

      <div class="flex items-center justify-between border-b border-[var(--page-border)] bg-[var(--terminal-chrome)] px-4 py-3">
        <div class="flex items-center gap-2">
          <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
          <span class="h-3 w-3 rounded-full bg-[var(--terminal-alert)]"></span>
          <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
        </div>

        <p class="font-mono text-sm text-[var(--terminal-muted)]">
          tyler@portfolio: ~/about
        </p>

        <span class="font-mono text-xs text-[var(--terminal-muted)]">
          bash
        </span>
      </div>

      <div class="space-y-6 p-6 font-mono text-sm leading-relaxed text-[var(--terminal-foreground)] md:p-8 md:text-base">
        <div>
          <p>
            <span class="text-[var(--terminal-prompt)]">tyler@portfolio</span>:<span class="text-[var(--terminal-path)]">~</span>$ whoami
          </p>
          <p class="mt-1 text-[var(--terminal-foreground)]">
            Tyler Dalton
          </p>
        </div>

        <div>
          <p>
            <span class="text-[var(--terminal-prompt)]">tyler@portfolio</span>:<span class="text-[var(--terminal-path)]">~</span>$ cat profile.txt
          </p>

          <p class="mt-1 max-w-3xl text-[var(--terminal-secondary)]">
            Cyber/Electronic Operations & Warfare + Network/Systems Administration student at the University of Cincinnati focused on secure infrastructure, automation, and platform engineering.
          </p>
        </div>

        <div>
          <p>
            <span class="text-[var(--terminal-prompt)]">tyler@portfolio</span>:<span class="text-[var(--terminal-path)]">~</span>$ status
          </p>

          <div class="mt-2 grid gap-x-8 gap-y-1 md:grid-cols-[140px_1fr]">
            <span class="text-[var(--terminal-muted)]">education</span>
            <span>University of Cincinnati</span>

            <span class="text-[var(--terminal-muted)]">major</span>
            <span>Cybersecurity + Network/Systems Administration</span>

            <span class="text-[var(--terminal-muted)]">location</span>
            <span>Cincinnati, Ohio</span>

            <span class="text-[var(--terminal-muted)]">focus</span>
            <span>Kubernetes / Infrastructure / Automation</span>

            <span class="text-[var(--terminal-muted)]">availability</span>
            <span>Spring & Summer 2027</span>
          </div>
        </div>

        <div>
          <p>
            <span class="text-[var(--terminal-prompt)]">tyler@portfolio</span>:<span class="text-[var(--terminal-path)]">~</span>$ currently building
          </p>

          <p class="mt-1 text-[var(--terminal-secondary)]">
            <span id="terminal-output">olympus kubernetes cluster</span><span id="terminal-cursor" class="text-[var(--terminal-foreground)]">█</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  const projects = [
    "Olympus kubernetes cluster",
    "Pantheon agentic environment",
    "physical Cisco networking labs",
    "open-source contributions",
  ];

  const output = document.getElementById("terminal-output");
  const cursor = document.getElementById("terminal-cursor");

  if (output) {
    let projectIndex = 0;
    let characterIndex = projects[0].length;
    let deleting = true;

    const typeSpeed = 65;
    const deleteSpeed = 35;
    const pauseAfterTyping = 2200;
    const pauseBeforeTyping = 400;

    const animate = () => {
      cursor?.classList.remove("animate-pulse");
      const project = projects[projectIndex];

      if (deleting) {
        characterIndex--;
        output.textContent = project.slice(0, characterIndex);

        if (characterIndex === 0) {
          deleting = false;
          projectIndex = (projectIndex + 1) % projects.length;

          setTimeout(animate, pauseBeforeTyping);
          return;
        }

        setTimeout(animate, deleteSpeed);
        return;
      }

      characterIndex++;
      const nextProject = projects[projectIndex];
      output.textContent = nextProject.slice(0, characterIndex);

      if (characterIndex === nextProject.length) {
        deleting = true;
        cursor?.classList.add("animate-pulse");

        setTimeout(animate, pauseAfterTyping);
        return;
      }

      setTimeout(animate, typeSpeed);
    };

    setTimeout(animate, pauseAfterTyping);
  }
</script>
