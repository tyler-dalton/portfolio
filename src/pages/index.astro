---
import Layout from "../layouts/layout.astro";
import AboutTerminal from "../components/terminal.astro";
import SelectedWork from "../components/project-card.astro";
---

<Layout title="Tyler Dalton | Home">
  <!-- HERO -->
	<section class="px-4 py-16">
    <div class="mx-auto flex max-w-[1100px] flex-col items-center gap-12 md:flex-row">
      <!-- Headshot -->
      <div>
        <img
          src="/media/headshot.jpg"
          alt="Professional headshot of Tyler Dalton"
          class="h-[260px] w-[260px] rounded-full border-3 border-[var(--page-border)] object-cover shadow-[0_18px_40px_rgba(0,0,0,0.18)] md:h-[340px] md:w-[340px]"
        />
      </div>
      <!-- Introduction -->
      <div class="max-w-xl">
        <h1 class="mb-3 text-5xl font-bold tracking-tight md:text-6xl">
          Hi, I'm Tyler Dalton.
        </h1>
        <p class="max-w-xl text-xl leading-relaxed text-[var(--page-foreground)]/90 md:text-2xl">
          Cybersecurity + Systems Administration student at the University of Cincinnati focused on secure infrastructure and automation.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/projects"
            class="inline-block rounded-full bg-[var(--page-foreground)] px-[1.6em] py-[0.65em] font-semibold tracking-[0.2em] text-[var(--page-background)] no-underline transition-all duration-200 hover:-translate-y-0.5"
          >
            View My Work
          </a>
          <a
            href="/contact"
            class="inline-block rounded-full border border-[var(--page-foreground)]/60 px-[1.6em] py-[0.65em] font-semibold tracking-[0.2em] text-[var(--page-foreground)] no-underline transition-all duration-200 hover:-translate-y-0.5 hover:bg-[color-mix(in_srgb,var(--page-foreground)_10%,transparent)]"
          >
            Contact Me
          </a>
        </div>
      </div>
    </div>
  </section>
  <div class="px-4 pb-2 text-center">
    <button
      id="command-palette-trigger"
      class="command-hint"
      type="button"
      aria-haspopup="dialog"
      aria-controls="command-palette"
    >
      Check out my command palette <kbd>(⌘ K / Ctrl + K)</kbd>
    </button>
  </div>
  <!-- Importing About Terminal from Components -->
  <AboutTerminal />
  <!-- Selected Projects import from components -->
  <SelectedWork />

  <!-- GitHub Contribution Activity -->
  <section class="px-4 py-6">
      <div class="mx-auto max-w-[1100px] pt-10">
        <div class="mb-5 flex items-baseline justify-between gap-4">
          <h2 class="text-3xl font-semibold tracking-tight">GitHub Contributions</h2>
          <a
            href="https://github.com/tyler-dalton"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-[var(--page-muted)] transition-colors hover:text-[var(--page-foreground)]"
          >
            @tyler-dalton ↗
          </a>
        </div>

        <div class="overflow-x-auto">
          <div
            id="contribution-graph"
            class="block min-w-[735px] [&_svg]:block [&_svg]:h-auto [&_svg]:w-full"
            aria-label="Tyler Dalton's GitHub contributions over the last year"
          >
            <img
              src="/github/contributions.svg"
              alt="Tyler Dalton's GitHub contributions over the last year"
              class="block h-auto w-full"
              loading="lazy"
            />
          </div>
        </div>

        <div
          id="contribution-tooltip"
          class="pointer-events-none fixed z-50 hidden rounded-md border border-[var(--page-border)] bg-[var(--terminal-chrome)] px-2.5 py-1.5 text-xs text-[var(--terminal-foreground)] shadow-lg"
          role="tooltip"
        ></div>
      </div>
    </section>
    <script>
      const graph = document.getElementById("contribution-graph");
      const tooltip = document.getElementById("contribution-tooltip");

      if (graph && tooltip) {
        const formatDate = (date: string) =>
          new Intl.DateTimeFormat("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric",
            timeZone: "UTC",
          }).format(new Date(`${date}T00:00:00Z`));

        const tooltipText = (square: SVGRectElement) => {
          const date = square.dataset.date;
          const count = Number(square.dataset.count ?? 0);
          const contributionWord = count === 1 ? "contribution" : "contributions";

          return `${count} ${contributionWord} on ${formatDate(date!)}`;
        };

        const positionTooltip = (x: number, y: number) => {
          const offset = 12;
          const padding = 8;
          const rect = tooltip.getBoundingClientRect();

          let left = x + offset;
          let top = y - rect.height - offset;

          if (left + rect.width > window.innerWidth - padding) {
            left = x - rect.width - offset;
          }

          if (top < padding) {
            top = y + offset;
          }

          tooltip.style.left = `${Math.max(padding, left)}px`;
          tooltip.style.top = `${Math.max(padding, top)}px`;
        };

        const showTooltip = (square: SVGRectElement, x: number, y: number) => {
          tooltip.textContent = tooltipText(square);
          tooltip.classList.remove("hidden");
          positionTooltip(x, y);
        };

        const hideTooltip = () => {
          tooltip.classList.add("hidden");
        };

        fetch("/github/contributions.svg")
          .then((response) => {
            if (!response.ok) throw new Error("Could not load contribution graph");
            return response.text();
          })
          .then((svgText) => {
            const parsed = new DOMParser().parseFromString(svgText, "image/svg+xml");
            const svg = parsed.documentElement;

            if (svg.nodeName.toLowerCase() !== "svg") return;

            graph.replaceChildren(document.importNode(svg, true));

            graph.querySelectorAll("rect").forEach((square) => {
              const title = square.querySelector("title");

              if ((!square.dataset.date || square.dataset.count === undefined) && title?.textContent) {
                const match = title.textContent.match(
                  /^(\d{4}-\d{2}-\d{2}): (\d+) contributions?$/,
                );

                if (match) {
                  square.dataset.date = match[1];
                  square.dataset.count = match[2];
                }
              }

              if (!square.dataset.date || square.dataset.count === undefined) return;

              title?.remove();

              square.addEventListener("pointerenter", (event) => {
                showTooltip(square, event.clientX, event.clientY);
              });

              square.addEventListener("pointermove", (event) => {
                positionTooltip(event.clientX, event.clientY);
              });

              square.addEventListener("pointerleave", hideTooltip);

              square.addEventListener("focus", () => {
                const rect = square.getBoundingClientRect();
                showTooltip(square, rect.left + rect.width / 2, rect.top);
              });

              square.addEventListener("blur", hideTooltip);
            });
          })
          .catch(() => {
          });
      }
    </script>
</Layout>
