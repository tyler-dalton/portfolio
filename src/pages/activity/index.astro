---
import Layout from "../../layouts/layout.astro";
import SectionHub from "../../components/section-hub.astro";
---
<Layout title="Tyler Dalton | Activity"
        socialTitle="Activity - Tyler Dalton"
        description="Explore Tyler Dalton's recent activity through GitHub contributions, project updates, and timeline of ongoing work.">
  <SectionHub
    title="A record of work in motion."
    intro="Updates, contribution history, and context for what is being built over time."
    links={[
      { label: "GitHub",
      href: "/activity/github",
      description: "Contribution activity and open-source presence." },

      { label: "Timeline",
      href: "/activity/timeline",
      description: "Published milestones with a public source." },

      { label: "Changelog",
      href: "/activity/changelog",
      description: "Visitor-visible changes to this portfolio." }]} />
</Layout>
