---
interface Stat {
  value: string;
  label: string;
  detail?: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

{stats.length > 0 && (
  <section class="border-t border-[var(--page-border)] py-10" aria-labelledby="project-impact-heading">
    <h2 id="project-impact-heading" class="text-2xl font-bold">Project impact</h2>
    <dl class="mt-6 grid gap-px overflow-hidden rounded-lg border border-[var(--page-border)] bg-[var(--page-border)] sm:grid-cols-3">
      {stats.map((stat) => (
        <div class="bg-[var(--page-background)] p-6">
          <dt class="text-sm font-medium leading-relaxed text-[var(--page-secondary)]">{stat.label}</dt>
          <dd class="mt-3 text-4xl font-bold tracking-tight text-[var(--page-foreground)]">{stat.value}</dd>
          {stat.detail && <p class="mt-3 text-sm leading-relaxed text-[var(--page-muted)]">{stat.detail}</p>}
        </div>
      ))}
    </dl>
  </section>
)}
