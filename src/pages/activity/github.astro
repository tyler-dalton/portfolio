---
import Layout from "../../layouts/layout.astro";
import ContributionGraph from "../../components/contribution-graph.astro";
import Metrics from "../../components/activity/metrics.astro";
import Bars from "../../components/activity/bars.astro";
import Languages from "../../components/activity/languages.astro";
import CommitRail from "../../components/activity/commit-rail.astro";
import RepoRows from "../../components/activity/repo-rows.astro";
import { analytics } from "../../lib/analytics-view";
import { countLabel, formatDay, formatFull } from "../../lib/github-analytics";
import "../../styles/activity.css";

const monthStart = analytics.months[0];
const monthEnd = analytics.months[analytics.months.length - 1];

const sameYearRange = (start: string, end: string) =>
  start.slice(0, 4) === end.slice(0, 4)
    ? `${formatDay(start)} – ${formatFull(end)}`
    : `${formatFull(start)} – ${formatFull(end)}`;
---

<Layout
  title="Tyler Dalton | GitHub"
  socialTitle="GitHub - Tyler Dalton"
  description="Contribution totals, public commits, and language share for Tyler Dalton."
>
  <section class="px-4 py-16 md:py-24">
    <div class="mx-auto max-w-[1100px]">
      <header class="activity-intro">
        <p class="activity-kicker">GitHub</p>
        <h1>A look at what I'm building</h1>
        <p class="activity-lede">
          Contribution totals from GitHub's calendar, and commits from the public repositories.
        </p>
        <p class="activity-caption">
          Contributions through {formatFull(analytics.contributionAsOf)}. Commits through {formatFull(analytics.commitAsOf)}.
        </p>
      </header>

      <p class="activity-kicker activity-kicker--section">Last 30 days</p>
      <Metrics metrics={analytics.metrics} />

      <section class="activity-section" aria-labelledby="activity-months">
        <div class="activity-section__head">
          <h2 id="activity-months">By month</h2>
          <p>Contributions · {monthStart.label} – {monthEnd.label}</p>
        </div>
        <Bars bars={analytics.months} label="Contributions by month" />
      </section>

      <section class="activity-section" aria-labelledby="activity-weekdays">
        <div class="activity-section__head">
          <h2 id="activity-weekdays">By weekday</h2>
          <p>Contributions · {sameYearRange(analytics.weekdayWindow.start, analytics.weekdayWindow.end)}</p>
        </div>
        <Bars bars={analytics.weekdays} label="Contributions by weekday for the trailing 90 days" />
      </section>

      <section class="activity-section" aria-labelledby="activity-languages">
        <div class="activity-section__head">
          <h2 id="activity-languages">Languages</h2>
          <p>Share of code</p>
        </div>
        <Languages languages={analytics.languages} />
      </section>

      <section class="activity-section" aria-labelledby="activity-recent">
        <div class="activity-section__head">
          <h2 id="activity-recent">Recent activity</h2>
          <p>Commits · {sameYearRange(analytics.commitWindow.start, analytics.commitWindow.end)}</p>
        </div>
        <CommitRail days={analytics.recentDays} />
      </section>

      <section class="activity-section" aria-labelledby="activity-graph">
        <div class="activity-section__head">
          <h2 id="activity-graph">Contribution graph</h2>
          <p>
            {countLabel(analytics.contributionTotal, "contribution")} · {formatFull(analytics.contributionFrom)} – {formatFull(analytics.contributionTo)}
          </p>
        </div>
        <div class="activity-graph">
          <ContributionGraph
            total={analytics.contributionTotal}
            from={analytics.contributionFrom}
            to={analytics.contributionTo}
          />
        </div>
        <p class="activity-scroll">Scroll sideways for the earlier months.</p>
      </section>

      <section class="activity-section" aria-labelledby="activity-repos">
        <div class="activity-section__head">
          <h2 id="activity-repos">Recently active</h2>
          <p>Commits · {sameYearRange(analytics.commitWindow.start, analytics.commitWindow.end)}</p>
        </div>
        <RepoRows repositories={analytics.activeRepositories} />
      </section>

      <footer class="activity-source">
        <p>
          Contributions follow GitHub's calendar through {formatFull(analytics.contributionAsOf)}, and can include private contributions.
        </p>
        <p>
          Commit counts are authored non-merge commits on public repositories through {formatFull(analytics.commitAsOf)}.
        </p>
        <p>Language shares are bytes of code, not time.</p>
      </footer>
    </div>
  </section>
</Layout>
